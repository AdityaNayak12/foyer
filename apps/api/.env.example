PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (Supabase / Postgres Connection Strings)
DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# Authentication (Clerk JWKS Verification Endpoint)
CLERK_JWKS_URI="https://clerk.foyer.dev/.well-known/jwks.json"

# Payments (Razorpay Credentials)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="sec_..."

# Security
JWT_SECRET="super-secure-high-entropy-jwt-signing-secret"

# Observability
SENTRY_DSN="https://..."
